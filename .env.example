# OpenClaw Docker Configuration
# Copy to .env and fill in your values

# Image (build with: docker build -t openclaw:custom -f Dockerfile.custom .)
OPENCLAW_IMAGE=openclaw:custom

# Paths (bind-mounted into container)
OPENCLAW_CONFIG_DIR=/path/to/.openclaw
OPENCLAW_WORKSPACE_DIR=/path/to/.openclaw/workspace

# Gateway token (generate with: openssl rand -hex 32)
OPENCLAW_GATEWAY_TOKEN=your_gateway_token_here
OPENCLAW_GATEWAY_PORT=18789

# Cloudflare Tunnel token (from Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
